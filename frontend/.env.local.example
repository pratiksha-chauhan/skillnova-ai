# Copy this file to .env.local (gitignored) for local development.
# Base URL of the SkillNova AI backend API. The Next.js dev server runs on
# :3000 and the Spring Boot backend on :8080 - see backend/docker-compose.yml
# and backend/src/main/resources/application-dev.properties.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
