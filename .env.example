# Copy to .env and fill in real values. Never commit the actual .env file.

# --- Local development (docker-compose.yml) ---
DB_USERNAME=skillnova
DB_PASSWORD=skillnova
# Host port for the Postgres container. Defaults to 5433 so it doesn't
# clash with a Postgres instance already running locally on 5432.
DB_HOST_PORT=5433

# --- Production (Render backend, Neon PostgreSQL) ---
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
# DB_USERNAME=<neon-username>
# DB_PASSWORD=<neon-password>
# DB_POOL_SIZE=5

# --- JWT (Phase 6) ---
# Required in prod (no fallback there). Local dev falls back to a built-in
# insecure secret in application-dev.properties if this is left unset, but
# setting it here is recommended so everyone's tokens use the same secret.
# Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-signing-secret-change-me-0123456789
# Access token lifetime in milliseconds. Default 3600000 = 1 hour.
JWT_EXPIRATION_MS=3600000

# --- AI provider (introduced in Phase 8) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
